# Local development (pnpm dev). Docker deployments are configured via the root .env instead.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secret_hitler
REDIS_URL=redis://localhost:6379
COOKIE_SECRET=dev-secret

# Only for split deployments (frontend served from a different origin).
# Unset = same-origin mode (nginx/Vite proxy), cookies SameSite=Lax.
# CLIENT_ORIGIN=https://your-frontend.example.com
