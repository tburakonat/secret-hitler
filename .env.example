# Copy to .env and adjust before `docker compose up -d --build`.

# ─── Required ────────────────────────────────────────────────────────────────
# Note: applied only on first start. Changing it later requires wiping the
# volume (docker compose down -v) or an ALTER USER inside the container.
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me

# ─── Optional ────────────────────────────────────────────────────────────────
# The single exposed port of the stack (frontend nginx, proxies to the backend).
APP_PORT=8080
# Set to true when a HTTPS reverse proxy (Caddy/Traefik/nginx) sits in front.
COOKIE_SECURE=false
# POSTGRES_USER=postgres
# POSTGRES_DB=secret_hitler
# PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
# PGADMIN_DEFAULT_PASSWORD=pgadmin
